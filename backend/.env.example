# backend/.env.example
#
# PURPOSE: This file is a template for the environment variables the backend needs.
# It is safe to commit to Git because it contains NO real credentials — only
# placeholder values.
#
# HOW TO USE:
#   1. Copy this file and name the copy exactly ".env" (no ".example"):
#
#        Windows (VS Code terminal):
#        copy .env.example .env
#
#   2. Open the new .env file and replace every <placeholder> with your real values.
#   3. Never commit .env to Git — it is already listed in the root .gitignore.

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ───────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → your cluster → Connect → Drivers.
# Replace <username>, <password>, <cluster-url>, and <database-name>.
# Example: mongodb+srv://alice:s3cr3t@cluster0.abc12.mongodb.net/user-analytics
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
