# frontend/.env.example
#
# Copy this file to .env and set the correct backend URL.
# Vite exposes variables prefixed with VITE_ to the browser bundle.
# Never put secrets in these files — they are bundled into public JS.
#
#   Windows:  copy .env.example .env
#
# For local development the default inside api.js already works,
# so creating .env is optional unless you change the backend port.

VITE_API_BASE_URL=http://localhost:5000
